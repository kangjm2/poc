# Copy to .env to override the compose defaults. Every value below is the default,
# so an empty .env behaves exactly like no .env at all.
#
# The vdt/vdt pair is a development credential and is fine for a local POC stack,
# where PostgreSQL is not published outside the compose network. Change DB_PASSWORD
# before running this anywhere reachable by anyone else.

DB_NAME=vdt
DB_USER=vdt
DB_PASSWORD=vdt

# Ports published on the host.
BACKEND_PORT=8080
FRONTEND_PORT=4173

# Backend container memory limit. The JVM sizes its max heap at 75% of this, so it is
# the knob that bounds the backend. ~350 MB is normal analysis load.
BACKEND_MEMORY=2g

# false brings the stack up migrated but empty - no demo sessions and, note, no KPI
# definitions either. A CSV imported into that stack therefore has nothing to match its
# columns against, so tick "Define a KPI for every unrecognised column" on the import
# screen or every KPI column is dropped.
SEED_ENABLED=true
